# Telegram API Credentials from my.telegram.org
API_ID="YOUR_API_ID_HERE"
API_HASH="YOUR_API_HASH_HERE"

# Bot Token from @BotFather
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Bot Username without the "@"
BOT_USERNAME="YOUR_BOT_USERNAME_HERE"

# Admin User ID (your Telegram user ID) for special commands like /broadcast
ADMIN_ID="YOUR_USER_ID_HERE"

# MongoDB Credentials # IF U ARE USING IN MOBILE USE NON-SRV MONGO DB OR IF USING IN VPS OR RDP USE NORMAL SRV URL 
MONGO_URI="YOUR_MONGO_DB_URL_HERE"
MONGO_DB_NAME="YOUR_ANYTHING_MONGO_DB_NAME_HERE"

# FileBrowser Config
FILEBROWSER_API_URL="http://YOUR_FILE_BROWSER_URL_HERE/api"
FILEBROWSER_ADMIN_USER="YOUR_FILEBROWSER_ADMIN_USERNAME"
FILEBROWSER_ADMIN_PASS="YOUR_FILEBROSWER_ADMIN_PASS"
FILEBROWSER_PUBLIC_URL="http://YOUR_FILEBROSWER_URL_HERE/"

PORT="8080"